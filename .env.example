# Copy to .env and edit. Real environment variables override this file.

APP_ENV=development
HOST=127.0.0.1
PORT=5000
DEBUG=1

# Leave unset to auto-generate a persistent random key in instance/secret_key.
# SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 when served over HTTPS. Production defaults to 1.
SESSION_COOKIE_SECURE=0

# First run on an empty database: 1 = seed the built-in demo school,
# 0 = create just an "admin" account (password below, or random + printed to the log).
AUTO_SEED_DEMO=1
# INITIAL_ADMIN_PASSWORD=choose-a-strong-password

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# Background job workers, vector search backend (auto | faiss | numpy), logging
JOB_WORKERS=2
VECTOR_BACKEND=auto
LOG_LEVEL=INFO

# Optional writable storage paths (set these to a persistent disk mount on a paid host).
# DATABASE_PATH=/var/data/attendance.db
# FACES_DIR=/var/data/faces
# FACE_GALLERY_PATH=/var/data/models/face_gallery.npz
# ML_DATASET_PATH=/var/data/academic_dataset.csv
# MODEL_REGISTRY_DIR=/var/data/models/registry
# CURRENT_VERSION_POINTER=/var/data/models/registry/current_version.txt
# BASELINE_STATS_PATH=/var/data/models/registry/training_baseline_stats.json
# LOG_TO_FILE=0  # prefer console logs on managed hosting
